import requests

OLLAMA_URL = "http://localhost:11434/api/chat"
MODEL_NAME = "llama3.2:latest"

SYSTEM_PROMPT = """
You are CS Mentor AI, a dedicated Computer Science Engineering tutor.

Your students are engineering students, including beginners.
Teach Computer Science subjects such as:
- C, Python, Java and JavaScript
- Data Structures and Algorithms
- Operating Systems
- Database Management Systems
- Computer Networks
- Software Engineering
- Computer Organization and Architecture
- Theory of Computation
- Compiler Design
- Cryptography and Network Security
- Cloud Computing
- Artificial Intelligence and Machine Learning
- Web Development

TEACHING RULES:
1. Explain concepts in simple, clear English.
2. Introduce technical terms and define them.
3. Use practical examples and real-world applications.
4. Explain difficult concepts step by step.
5. For programming, provide runnable code and explain its logic.
6. For debugging, identify the error, explain its cause, and show the correction.
7. For DSA, explain the algorithm, provide code, and analyze time and space complexity.
8. For exam answers, adapt the length to the requested marks.

EXAM ANSWER FORMAT:
- 2 marks: definition and key points.
- 5 marks: introduction, explanation, example, and conclusion.
- 10 marks: introduction, definition, detailed explanation, examples, diagram when useful, advantages or limitations, applications, and conclusion.

Be accurate, patient, practical, and encouraging.
If you are unsure of a fact, admit it rather than inventing an answer.
"""

MODE_INSTRUCTIONS = {
    "Learn Concept": "Teach the concept from fundamentals using examples.",
    "Exam Preparation": "Write a structured exam-ready answer appropriate to the requested marks.",
    "Code Tutor": "Explain programming logic, provide runnable code, and explain important lines.",
    "Debug My Code": "Find the likely bug, explain why it occurs, and provide corrected code.",
    "DSA Practice": "Explain the problem, approach, algorithm, complexity, and solution.",
    "Interview Preparation": "Provide a technical interview answer with reasoning and a follow-up question.",
    "Quick Revision": "Give concise definitions, key points, and a short revision example."
}


def ask_mentor(message, mode="Learn Concept", history=None):
    """Send a student's question to the local Ollama model."""

    message = message.strip()

    if not message:
        return "Please enter a question."

    if len(message) > 10000:
        return "Your message is too long. Please keep it under 10,000 characters."

    if mode not in MODE_INSTRUCTIONS:
        mode = "Learn Concept"

    messages = [
        {
            "role": "system",
            "content": SYSTEM_PROMPT + "\n\nCurrent learning mode: "
            + mode + ". " + MODE_INSTRUCTIONS[mode]
        }
    ]

    if history:
        for item in history[-10:]:
            if (
                isinstance(item, dict)
                and item.get("role") in ("user", "assistant")
                and isinstance(item.get("content"), str)
            ):
                messages.append({
                    "role": item["role"],
                    "content": item["content"][:10000]
                })

    messages.append({"role": "user", "content": message})

    try:
        response = requests.post(
            OLLAMA_URL,
            json={
                "model": MODEL_NAME,
                "messages": messages,
                "stream": False
            },
            timeout=120
        )
        response.raise_for_status()
        data = response.json()

        answer = data.get("message", {}).get("content", "")
        if not answer:
            return "The model returned an empty response. Please try again."

        return answer

    except requests.exceptions.ConnectionError:
        return (
            "Cannot connect to Ollama. Make sure Ollama is running "
            "and the llama3.2:latest model is installed."
        )
    except requests.exceptions.Timeout:
        return "Ollama took too long to respond. Please try again."
    except requests.exceptions.RequestException as error:
        return f"Ollama request failed: {error}"
    except (ValueError, KeyError):
        return "Ollama returned an unexpected response format."